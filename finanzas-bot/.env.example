# Token del bot (habla con @BotFather en Telegram y usa /newbot)
TELEGRAM_BOT_TOKEN=
# Clave de la API de Anthropic (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Tu id de Telegram (el bot te lo dice si le mandas /start). Varios separados por coma.
ALLOWED_USER_IDS=
# Moneda y zona horaria
CURRENCY=MXN
TIMEZONE=America/Mexico_City
# Carpeta donde se guardan la base de datos y los extractos
DATA_DIR=data

# --- Gmail (opcional; ver README "Conectar Gmail") ---
# Contraseñas para abrir estados de cuenta en PDF (p. ej. tu RFC o fecha de nacimiento), separadas por coma
PDF_PASSWORDS=
# Cada cuántos minutos revisar el correo
GMAIL_INTERVAL_MINUTES=15
# Cuántos días hacia atrás revisar la primera vez
GMAIL_LOOKBACK_DAYS=60
# Búsqueda de Gmail personalizada (opcional). Ej.: from:(bbva.mx OR banorte.com OR amazon.com.mx)
GMAIL_QUERY=
